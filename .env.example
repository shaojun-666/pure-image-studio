# ── 核心 ──
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=zh
TZ=Asia/Shanghai

# ── 数据库 ──
# 本地开发对应 docker-compose.dev.yml
DATABASE_URL=postgresql://aigc:aigc_dev_pw@localhost:5432/aigc?schema=public

# 生产用（docker compose 内部网络，服务名 db）
# POSTGRES_USER=aigc
# POSTGRES_PASSWORD=
# POSTGRES_DB=aigc
# DATABASE_URL=postgresql://aigc:<pw>@db:5432/aigc?schema=public&connection_limit=10&pool_timeout=20

# ── 认证（Auth.js v5）──
AUTH_URL=http://localhost:3000
AUTH_SECRET=dev-only-secret-change-me-in-production
AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── 存储 ──
STORAGE_DRIVER=local                # local | oss
STORAGE_LOCAL_ROOT=.data/storage
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT_INTERNAL=oss-cn-hangzhou-internal.aliyuncs.com
OSS_USE_INTERNAL=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
CDN_BASE_URL=http://localhost:3000/api/files

# ── 模型 Provider ──
# 火山引擎方舟。留空 = 方舟模型不注册。填了要重跑 seed 才会写进 ModelRegistry
ARK_API_KEY=
# 阿里云百炼（DashScope）。留空 = 通义/万相模型不注册。填了要重跑 seed 才会写进 ModelRegistry
DASHSCOPE_API_KEY=
# ofox.ai 中转站（OpenAI 兼容 /v1）。留空 = Nano Banana / GPT Image / MAI Image 不注册
OFOX_API_KEY=
MOCK_LATENCY_MS=1800
MOCK_ASYNC=false
MOCK_FAILURE_RATE=0
MOCK_TIMEOUT_RATE=0
PROVIDER_TIMEOUT_MS=120000
GENERATION_DEADLINE_MS=900000
POLL_INTERVAL_MS=3000

# ── Worker / 积分 ──
WORKER_ENABLED=true
WORKER_CONCURRENCY=3
LEASE_TTL_MS=180000
DAILY_FREE_CREDITS=20
SIGNUP_BONUS_CREDITS=30
RATE_LIMIT_GENERATIONS_PER_5MIN=10

# ── 运维 ──
CRON_SECRET=dev-cron-secret
LOG_LEVEL=info

# ── seed ──
# 留空则跳过管理员创建。后台入口本身要求 admin，所以第一个管理员只能由 seed 提供。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
