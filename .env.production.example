# 生产环境变量。复制成 .env 放在项目根目录（compose 会自动读它做插值），
# 权限设成 600，别进版本库。
#
#   cp .env.production.example .env && chmod 600 .env
#
# ★ 带「必须设置」的项没填，compose 会直接拒绝启动 —— 这是故意的，
#   宁可起不来，也不要带着半套配置对外服务。

# ── 站点（也会作为 build arg 内联进前端产物，换域名必须重新 build）──
NEXT_PUBLIC_SITE_URL=https://www.example.cn
NEXT_PUBLIC_DEFAULT_LOCALE=zh
HTTP_PORT=80
HTTPS_PORT=443

# ── 数据库（只在容器网络内可见，不映射端口）──
POSTGRES_USER=aigc
POSTGRES_PASSWORD=
POSTGRES_DB=aigc

# ── 认证 ──
# 生成：openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── 存储（生产走 OSS + CDN）──
STORAGE_DRIVER=oss
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# ★ 同区 ECS 一定用内网 endpoint：免公网流量费，且快约 10 倍
OSS_ENDPOINT_INTERNAL=oss-cn-hangzhou-internal.aliyuncs.com
OSS_USE_INTERNAL=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# ★ 必须是 CDN 域名，不是 OSS 域名。填错不会报错，只会让所有 public/* 图 404
CDN_BASE_URL=https://cdn.example.cn

# ── 模型 Provider ──
# ★ 火山引擎方舟。填完必须重跑 seed 服务，否则模型不会写进 ModelRegistry，
#   下拉框里看不到。留空则方舟模型不注册。
ARK_API_KEY=
# ofox.ai 中转站（OpenAI 兼容 /v1，含 Nano Banana / GPT Image / MAI Image）。
# 留空 = 这几个模型不注册。注意它按量从 ofox 余额扣费，不是免费额度。
OFOX_API_KEY=
# mock provider 保留：没有 key 时靠它跑通全链路压测
MOCK_LATENCY_MS=1800
MOCK_ASYNC=false
MOCK_FAILURE_RATE=0
MOCK_TIMEOUT_RATE=0

# ── Worker / 积分 ──
WORKER_ENABLED=true
WORKER_CONCURRENCY=3
# worker 挂掉后多久允许别人重领这条任务：调小恢复更快，但网络抖动时容易误抢
LEASE_TTL_MS=180000
DAILY_FREE_CREDITS=20
SIGNUP_BONUS_CREDITS=30
RATE_LIMIT_GENERATIONS_PER_5MIN=10

# ── 运维 ──
# 生成：openssl rand -hex 24
CRON_SECRET=
LOG_LEVEL=info
BACKUP_KEEP_DAYS=30

# ── 首次部署 seed 用（跑完就可以删掉这两行）──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
