# 构建上下文越小越快；也防止把本机 node_modules 覆盖进镜像层
node_modules
.pnpm-store

.next
.next-verify
.next-build
tsconfig.tsbuildinfo

# ★ 绝不进镜像：密钥走 compose 的 environment 注入
.env
.env.*
!.env.example

.data
deploy/backups
deploy/certs

.git
.gitignore
.vscode
.idea

**/*.log
npm-debug.log*
scripts

# 注意：项目里没有 public/ 目录（字体走系统栈、缩略图全在存储里），
# 所以 runner 阶段刻意不 COPY public —— 加了会直接构建失败
